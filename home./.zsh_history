: 1779350795:0;echo "\
  fd = os.open('/dev/mem', os.O_RDWR | os.O_SYNC)\
  cim = mmap.mmap(fd, 0x4000, offset=0xA0000000)\
  # ËØª STATUS (0x004)\
  s = struct.unpack('<I', cim[0x004:0x008])[0]\
  print(f'STATUS = 0x{s:08X}')\
  # ËØªÂÉªÉæÂÉ®É∫ÂÉ¶ÉπÁÉ∫É§ IN_DIM (0x010) È™É¨ËØÅÂÉ¶ÉπÈÄÉ∫Ë∑Ø\
  v = struct.unpack('<I', cim[0x010:0x014])[0]\
  print(f'IN_DIM  = 0x{v:08X} (before write)')\
  cim[0x010:0x014] = struct.pack('<I', 0xDEAD)\
  v2 = struct.unpack('<I', cim[0x010:0x014])[0]\
  print(f'IN_DIM  = 0x{v2:08X} (after write 0xDEAD)')\
  cim.close()\
  os.close(fd)\
  " > temp.sh
