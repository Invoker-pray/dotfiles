#!/bin/bash
# /* ---- AutoDetectDisplay.sh ---- */
# 自动检测屏幕 DPI，根据物理尺寸和分辨率调整 Hyprland 缩放和字体大小
# 适用于移动硬盘系统跨不同电脑使用

LOG="/tmp/autodetect_display.log"
exec > >(tee -a "$LOG") 2>&1
echo "=== AutoDetectDisplay: $(date) ==="

# ============================================================
# 0. 等待 Hyprland 就绪
# ============================================================
for i in $(seq 1 30); do
    if hyprctl monitors 2>/dev/null | grep -q '^Monitor'; then
        echo "Hyprland 已就绪 (等待 ${i}s)"
        break
    fi
    sleep 1
done

# ============================================================
# 0.5 指纹检查 — 显示器没变就跳过
# ============================================================
FINGERPRINT_FILE="/tmp/autodetect_display_fingerprint"
CURRENT_FP=$(hyprctl monitors 2>/dev/null | grep -E '(^Monitor |physical size|^\s+\d+x\d+)' | md5sum | cut -d' ' -f1)

if [ -f "$FINGERPRINT_FILE" ]; then
    LAST_FP=$(cat "$FINGERPRINT_FILE")
    if [ "$CURRENT_FP" = "$LAST_FP" ]; then
        echo "显示器未变化 (fingerprint=$CURRENT_FP)，跳过。"
        exit 0
    fi
    echo "显示器已变化: $LAST_FP → $CURRENT_FP"
else
    echo "首次运行 (fingerprint=$CURRENT_FP)"
fi

# ============================================================
# 1. 获取所有连接的显示器
# ============================================================
MONITORS=$(hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null)

if [ -z "$MONITORS" ]; then
    echo "⚠ 无法通过 hyprctl 获取显示器列表"
    exit 1
fi

echo "检测到显示器: $MONITORS"

# ============================================================
# 2. 分析每个显示器的 DPI
# ============================================================
declare -A MONITOR_RES_X MONITOR_RES_Y MONITOR_DPI MONITOR_SCALE

for mon in $MONITORS; do
    echo ""
    echo "--- 分析显示器: $mon ---"

    # 从 hyprctl 文本输出解析 (比 JSON 更可靠地获取物理尺寸)
    TEXT_OUT=$(hyprctl monitors 2>/dev/null | grep -A 50 "^Monitor $mon")

    # 分辨率
    RES_X=$(echo "$TEXT_OUT" | grep -oP '^\s+\K\d+x\d+' | head -1 | cut -d'x' -f1)
    RES_Y=$(echo "$TEXT_OUT" | grep -oP '^\s+\K\d+x\d+' | head -1 | cut -d'x' -f2)

    # 物理尺寸 (mm) — hyprctl 输出中的 "physical size (mm): WxH"
    PHYS_W=$(echo "$TEXT_OUT" | grep -oP 'physical size \(mm\):\s*\K\d+' | head -1)
    PHYS_H=$(echo "$TEXT_OUT" | grep -oP 'physical size \(mm\):\s*\d+x\K\d+' | head -1)

    echo "  分辨率: ${RES_X}x${RES_Y}"
    echo "  物理尺寸: ${PHYS_W}mm x ${PHYS_H}mm"

    # 计算 DPI
    if [ -n "$RES_X" ] && [ -n "$RES_Y" ] && [ -n "$PHYS_W" ] && [ -n "$PHYS_H" ] \
       && [ "$PHYS_W" != "0" ] && [ "$PHYS_H" != "0" ]; then
        # 有物理尺寸 → 精确计算
        PHYS_W_INCH=$(echo "scale=4; $PHYS_W / 25.4" | bc 2>/dev/null)
        PHYS_H_INCH=$(echo "scale=4; $PHYS_H / 25.4" | bc 2>/dev/null)
        DIAG_PX=$(echo "scale=4; sqrt($RES_X^2 + $RES_Y^2)" | bc 2>/dev/null)
        DIAG_INCH=$(echo "scale=4; sqrt($PHYS_W_INCH^2 + $PHYS_H_INCH^2)" | bc 2>/dev/null)
        DPI=$(echo "scale=0; $DIAG_PX / $DIAG_INCH" | bc 2>/dev/null)
    else
        # 无物理尺寸 → 根据分辨率估算
        echo "  ⚠ 无物理尺寸数据，根据分辨率估算 DPI..."
        DIAG_PX=$(echo "scale=4; sqrt($RES_X^2 + $RES_Y^2)" | bc 2>/dev/null)
        if [ -n "$DIAG_PX" ]; then
            if [ "$(echo "$DIAG_PX >= 4000" | bc 2>/dev/null)" = "1" ]; then
                DPI=157  # 4K 典型电视
            elif [ "$(echo "$DIAG_PX >= 3000" | bc 2>/dev/null)" = "1" ]; then
                DPI=110  # 1440p 典型
            else
                DPI=96   # 1080p 及以下
            fi
        else
            DPI=96
        fi
        echo "  估算 DPI: $DPI"
    fi

    echo "  实际 DPI: $DPI"

    # DPI → 缩放比例 映射
    if [ "$DPI" -le 110 ]; then
        SCALE="1.00"
    elif [ "$DPI" -le 135 ]; then
        SCALE="1.25"
    elif [ "$DPI" -le 175 ]; then
        SCALE="1.50"
    elif [ "$DPI" -le 230 ]; then
        SCALE="1.75"
    else
        SCALE="2.00"
    fi
    echo "  → 缩放比例: $SCALE"

    MONITOR_RES_X[$mon]=$RES_X
    MONITOR_RES_Y[$mon]=$RES_Y
    MONITOR_DPI[$mon]=$DPI
    MONITOR_SCALE[$mon]=$SCALE
done

# ============================================================
# 3. 取最大 DPI 作为基准
# ============================================================
MAX_DPI=0
MAX_SCALE="1.00"
for mon in "${!MONITOR_DPI[@]}"; do
    dpi=${MONITOR_DPI[$mon]}
    if [ "$dpi" -gt "$MAX_DPI" ]; then
        MAX_DPI=$dpi
        MAX_SCALE=${MONITOR_SCALE[$mon]}
    fi
done

echo ""
echo "============================================"
echo "  最终: DPI=$MAX_DPI  Scale=$MAX_SCALE"
echo "============================================"

# ============================================================
# 4. 生成 monitors.conf
# ============================================================
MONITOR_CONF="$HOME/.config/hypr/monitors.conf"
BACKUP_CONF="$HOME/.config/hypr/monitors.conf.bak"

cp "$MONITOR_CONF" "$BACKUP_CONF" 2>/dev/null

# 写入头
cat > "$MONITOR_CONF" << EOF
# Auto-generated by AutoDetectDisplay.sh
# Generated at: $(date)
# DPI: $MAX_DPI, Scale: $MAX_SCALE
#
# 如需手动覆盖，编辑此文件
# 备份: monitors.conf.bak

EOF

# 写入每个显示器的配置
for mon in "${!MONITOR_RES_X[@]}"; do
    scale=${MONITOR_SCALE[$mon]}
    echo "monitor=$mon,preferred,auto,$scale" >> "$MONITOR_CONF"
done

echo "✓ 已生成 $MONITOR_CONF"

# ============================================================
# 5. 根据 scale 调整各组件的字体
# ============================================================

# 基准值 (scale=1.0 时的理想大小)
BASE_GTK_FONT=10
BASE_KITTY_FONT=16
BASE_ROFI_CONFIG=14
BASE_ROFI_ELEMENT=12
BASE_CURSOR=24

# 计算缩放后值
calc_scaled() {
    echo "$1 * $2" | bc 2>/dev/null | awk '{printf "%.0f", $1}'
}

NEW_GTK=$(calc_scaled $BASE_GTK_FONT $MAX_SCALE)
NEW_KITTY=$(calc_scaled $BASE_KITTY_FONT $MAX_SCALE)
NEW_ROFI_CFG=$(calc_scaled $BASE_ROFI_CONFIG $MAX_SCALE)
NEW_ROFI_ELEM=$(calc_scaled $BASE_ROFI_ELEMENT $MAX_SCALE)
NEW_CURSOR=$(calc_scaled $BASE_CURSOR $MAX_SCALE)

echo ""
echo "--- 字体调整计划 (scale=$MAX_SCALE) ---"
echo "  GTK font:       ${BASE_GTK_FONT} → ${NEW_GTK} pt"
echo "  Kitty font:     ${BASE_KITTY_FONT} → ${NEW_KITTY} pt"
echo "  Rofi config:    ${BASE_ROFI_CONFIG} → ${NEW_ROFI_CFG} pt"
echo "  Rofi element:   ${BASE_ROFI_ELEMENT} → ${NEW_ROFI_ELEM} pt"
echo "  Cursor size:    ${BASE_CURSOR} → ${NEW_CURSOR} px"

# ---- GTK 3.0 font ----
GTK_INI="$HOME/.config/gtk-3.0/settings.ini"
if [ -f "$GTK_INI" ]; then
    sed -i "s/^gtk-font-name=.*/gtk-font-name=Noto Sans,  $NEW_GTK/" "$GTK_INI"
    echo "✓ GTK 字体: ${NEW_GTK}pt"
fi

# ---- Kitty ----
KITTY_CONF="$HOME/.config/kitty/kitty.conf"
if [ -f "$KITTY_CONF" ]; then
    # 修复 root 权限问题
    if [ ! -w "$KITTY_CONF" ]; then
        echo "⚠ Kitty 配置文件权限异常: $(ls -l "$KITTY_CONF")"
        sudo chown "$USER:$USER" "$KITTY_CONF" 2>/dev/null || \
            echo "⚠ 无法修复权限，请手动执行: sudo chown $USER:$USER $KITTY_CONF"
    fi
    if grep -q '^font_size' "$KITTY_CONF"; then
        sed -i "s/^font_size .*/font_size $NEW_KITTY/" "$KITTY_CONF"
    else
        echo "font_size $NEW_KITTY" >> "$KITTY_CONF"
    fi
    echo "✓ Kitty 字体: ${NEW_KITTY}pt"
fi

# ---- Rofi ----
# 0-shared-fonts.rasi 中有两个 font 行，需要分别处理
ROFI_FONTS="$HOME/.config/rofi/0-shared-fonts.rasi"
if [ -f "$ROFI_FONTS" ]; then
    # 第一个 font (configuration 块) — 用行号定位
    python3 -c "
import re
with open('$ROFI_FONTS', 'r') as f:
    content = f.read()

# 第一个 font: 行在 configuration { } 块中
# 第二个 font: 行在 element-text { } 块中
done_first = False
lines = content.split('\n')
new_lines = []
for line in lines:
    if 'font:' in line and 'JetBrainsMono' in line:
        if not done_first:
            line = re.sub(r'\"JetBrainsMono Nerd Font SemiBold \d+\"',
                          '\"JetBrainsMono Nerd Font SemiBold $NEW_ROFI_CFG\"', line)
            done_first = True
        else:
            line = re.sub(r'\"JetBrainsMono Nerd Font SemiBold \d+\"',
                          '\"JetBrainsMono Nerd Font SemiBold $NEW_ROFI_ELEM\"', line)
    new_lines.append(line)

with open('$ROFI_FONTS', 'w') as f:
    f.write('\n'.join(new_lines))
" 2>/dev/null

    # 如果 python 不可用，用 sed 做两次替换（利用上下文差异）
    if [ $? -ne 0 ]; then
        # 第一个 font 前面有 "configuration {"
        sed -i "/^configuration {/,/^}/ s/font: \"JetBrainsMono Nerd Font SemiBold [0-9]*\"/font: \"JetBrainsMono Nerd Font SemiBold $NEW_ROFI_CFG\"/" "$ROFI_FONTS"
        # 第二个 font 前面有 "element-text {"
        sed -i "/^element-text {/,/^}/ s/font: \"JetBrainsMono Nerd Font SemiBold [0-9]*\"/font: \"JetBrainsMono Nerd Font SemiBold $NEW_ROFI_ELEM\"/" "$ROFI_FONTS"
    fi
    echo "✓ Rofi 字体: config=${NEW_ROFI_CFG}pt, element=${NEW_ROFI_ELEM}pt"
fi

# ---- 光标 & GDK/QT 缩放 ----
ENV_CONF="$HOME/.config/hypr/UserConfigs/ENVariables.conf"
if [ -f "$ENV_CONF" ]; then
    sed -i "s/^env = HYPRCURSOR_SIZE,[0-9]*/env = HYPRCURSOR_SIZE,$NEW_CURSOR/" "$ENV_CONF"
    sed -i "s/^env = GDK_SCALE,[0-9.]*/env = GDK_SCALE,$MAX_SCALE/" "$ENV_CONF"
    sed -i "s/^env = QT_SCALE_FACTOR,[0-9.]*/env = QT_SCALE_FACTOR,$MAX_SCALE/" "$ENV_CONF"
    echo "✓ ENV: CURSOR=$NEW_CURSOR, GDK_SCALE=$MAX_SCALE, QT_SCALE=$MAX_SCALE"
fi

# ---- gsettings (立即对当前会话生效) ----
if command -v gsettings &>/dev/null; then
    gsettings set org.gnome.desktop.interface font-name "Noto Sans $NEW_GTK" 2>/dev/null &
    gsettings set org.gnome.desktop.interface cursor-size "$NEW_CURSOR" 2>/dev/null &
    echo "✓ gsettings 实时更新"
fi

# 保存指纹
echo "$CURRENT_FP" > "$FINGERPRINT_FILE"

echo ""
echo "=== AutoDetectDisplay 完成 ==="
echo "指纹: $CURRENT_FP"
echo "日志: $LOG"
echo ""
echo "已调整项:"
echo "  monitors.conf   → scale=$MAX_SCALE"
echo "  GTK font        → ${NEW_GTK}pt"
echo "  Kitty font      → ${NEW_KITTY}pt"
echo "  Rofi fonts      → ${NEW_ROFI_CFG}/${NEW_ROFI_ELEM}pt"
echo "  Cursor          → ${NEW_CURSOR}px"
echo "  GDK_SCALE       → $MAX_SCALE"
echo "  QT_SCALE_FACTOR → $MAX_SCALE"
